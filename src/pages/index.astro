---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile.jpeg';

const og = await getImage({ src: profile, width: 600, height: 600, format: 'jpeg' });

const links = [
  { label: 'GitHub', href: 'https://github.com/thegwan' },
  { label: 'Scholar', href: 'https://scholar.google.com/citations?user=Z-4DBYkAAAAJ&hl=en' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/gerrywan/' },
  { label: 'CV', href: '/files/gerry_wan_cv.pdf' },
];
---

<Base
  title="Gerry Wan"
  description="Gerry Wan works on Gemini inference efficiency at Google."
  image={og.src}
>
  <main>
    <Image
      src={profile}
      alt="Gerry Wan"
      width={176}
      height={176}
      densities={[1, 2]}
      class="photo"
      loading="eager"
    />
    <div class="text">
      <h1>Gerry Wan</h1>
      <p>I work on Gemini inference efficiency at Google.</p>
      <p>
        I received my PhD in Computer Science from
        <a href="https://cs.stanford.edu">Stanford University</a>, advised by
        <a href="https://zakird.com">Zakir Durumeric</a>. Previously, I graduated summa cum laude
        with a BSE in Electrical Engineering from
        <a href="https://ece.princeton.edu">Princeton University</a>, advised by
        <a href="https://www.princeton.edu/~pmittal">Prateek Mittal</a>.
      </p>
      <nav aria-label="Links">
        <ul>
          <li>
            <button type="button" class="bracket email" aria-expanded="false" aria-label="Show email address">
              <span class="slot label">Email</span><span class="slot addr" aria-live="polite"></span>
            </button>
          </li>
          {links.map((l) => (
            <li><a class="bracket" href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
</Base>

<script>
  // The address is assembled only on click, so it never appears in the page source.
  const btn = document.querySelector<HTMLButtonElement>('button.email');
  const addr = btn?.querySelector<HTMLSpanElement>('.addr');
  btn?.addEventListener('click', () => {
    if (!btn || !addr) return;
    if (!addr.textContent) {
      addr.textContent = 'moc tod liamg ta nwyrrg'.split('').reverse().join('');
    }
    // Slide to the address's real width so the motion ends exactly at the last letter.
    btn.style.setProperty('--addr-w', `${addr.scrollWidth}px`);
    const open = btn.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Hide email address' : 'Show email address');
  });
</script>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(64px, 16vh, 160px) 24px 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-start;
  }

  .photo {
    width: 88px;
    height: 88px;
    border-radius: 4px;
    object-fit: cover;
    flex: none;
    border: 1px solid var(--line);
  }

  .text {
    flex: 1 1 360px;
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-weight: 600;
    font-size: 28px;
    line-height: 1.2;
  }

  p { margin: 16px 0 0; }
  h1 + p { margin-top: 12px; }

  ul {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 16px;
    color: var(--muted);
  }

  /* Bracketed links: [GitHub] instead of underlines. */
  .bracket {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    color: var(--muted);
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 120ms ease;
  }

  .bracket::before { content: '['; }
  .bracket::after { content: ']'; }
  .bracket::before,
  .bracket::after { color: var(--muted); opacity: 0.6; transition: color 120ms ease, opacity 120ms ease; }

  .bracket:hover,
  .bracket:focus-visible { color: var(--accent); }
  .bracket:hover::before,
  .bracket:hover::after,
  .bracket:focus-visible::before,
  .bracket:focus-visible::after { color: var(--accent); opacity: 1; }

  .bracket:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Email: on open, the label steps aside and the address slides open left to right.
     On close, the address slides shut right to left, then the label returns. */
  .slot {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
  }

  .label {
    max-width: 5em;
    transition: max-width 0s 380ms, opacity 0s 380ms;
  }

  .addr {
    max-width: 0;
    transition: max-width 380ms cubic-bezier(0.3, 0.6, 0.2, 1);
  }

  .email.open { user-select: text; color: var(--ink); }
  .email.open .label { max-width: 0; opacity: 0; transition: none; }
  .email.open .addr { max-width: var(--addr-w, 16em); }

  @media (prefers-reduced-motion: reduce) {
    .slot, .bracket, .bracket::before, .bracket::after { transition: none; }
  }
</style>
