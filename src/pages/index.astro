---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile.jpeg';

const og = await getImage({ src: profile, width: 600, height: 600, format: 'jpeg' });

const links = [
  { label: 'GitHub', href: 'https://github.com/thegwan' },
  { label: 'Scholar', href: 'https://scholar.google.com/citations?user=Z-4DBYkAAAAJ&hl=en' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/gerrywan/' },
  { label: 'CV', href: '/files/gerry_wan_cv.pdf' },
];
---

<Base
  title="Gerry Wan"
  description="Gerry Wan works on inference efficiency for Gemini at Google."
  image={og.src}
>
  <main>
    <Image
      src={profile}
      alt="Gerry Wan"
      width={176}
      height={176}
      densities={[1, 2]}
      class="photo"
      loading="eager"
    />
    <div class="text">
      <h1>Gerry Wan</h1>
      <p>
        I work on inference efficiency for Gemini at Google.
      </p>
      <p>
        I did my PhD at Stanford on ML inference optimization and high-performance networking,
        and studied electrical engineering at Princeton.
      </p>
      <nav aria-label="Links">
        <ul>
          <li>
            <button type="button" class="bracket email" aria-expanded="false" aria-label="Show email address">
              <span class="slot label">Email</span><span class="slot addr" aria-live="polite"></span>
            </button>
          </li>
          {links.map((l) => (
            <li><a class="bracket" href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
</Base>

<script>
  // The address is assembled only on click, so it never appears in the page source.
  const btn = document.querySelector<HTMLButtonElement>('button.email');
  const addr = btn?.querySelector<HTMLSpanElement>('.addr');
  btn?.addEventListener('click', () => {
    if (!btn || !addr || btn.classList.contains('open')) return;
    addr.textContent = 'moc tod liamg ta nwyrrg'.split('').reverse().join('');
    btn.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
    btn.removeAttribute('aria-label');
  });
</script>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(64px, 16vh, 160px) 24px 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-start;
  }

  .photo {
    width: 88px;
    height: 88px;
    border-radius: 4px;
    object-fit: cover;
    flex: none;
    border: 1px solid var(--line);
  }

  .text {
    flex: 1 1 360px;
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 44px;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  p { margin: 16px 0 0; }
  h1 + p { margin-top: 20px; }

  ul {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 15px;
    color: var(--muted);
  }

  /* Bracketed links: [GitHub] instead of underlines. */
  .bracket {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    color: var(--muted);
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 120ms ease;
  }

  .bracket::before { content: '['; }
  .bracket::after { content: ']'; }
  .bracket::before,
  .bracket::after { color: var(--muted); opacity: 0.6; transition: color 120ms ease, opacity 120ms ease; }

  .bracket:hover,
  .bracket:focus-visible { color: var(--accent); }
  .bracket:hover::before,
  .bracket:hover::after,
  .bracket:focus-visible::before,
  .bracket:focus-visible::after { color: var(--accent); opacity: 1; }

  .bracket:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Email: the label slides shut while the address slides open. */
  .slot {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    transition: max-width 420ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 260ms ease;
  }

  .label { max-width: 5em; }
  .addr { max-width: 0; opacity: 0; }

  .email.open { cursor: text; user-select: text; color: var(--ink); }
  .email.open .label { max-width: 0; opacity: 0; }
  .email.open .addr { max-width: 16em; opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .slot, .bracket, .bracket::before, .bracket::after { transition: none; }
  }
</style>
