---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile.jpeg';

const og = await getImage({ src: profile, width: 600, height: 600, format: 'jpeg' });

const links = [
  { label: 'GitHub', href: 'https://github.com/thegwan' },
  { label: 'Scholar', href: 'https://scholar.google.com/citations?user=Z-4DBYkAAAAJ&hl=en' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/gerrywan/' },
  { label: 'CV', href: '/files/gerry_wan_cv.pdf' },
];
---

<Base
  title="Gerry Wan"
  description="Gerry Wan works on Gemini inference efficiency at Google."
  image={og.src}
>
  <main>
    <Image
      src={profile}
      alt="Gerry Wan"
      width={280}
      height={280}
      densities={[1, 2]}
      class="photo"
      loading="eager"
    />
    <div class="text">
      <h1>Gerry Wan</h1>
      <p>I work on Gemini inference efficiency at Google.</p>
      <!-- Keep each sentence on one line: Astro drops the space when a line break sits before a link. -->
      <p>I received my PhD in Computer Science from Stanford University, advised by <a href="https://zakird.com">Zakir Durumeric</a>, where I worked on ML inference optimization and high-performance networking. Previously, I graduated summa cum laude with a BSE in Electrical Engineering from Princeton University, advised by <a href="https://www.princeton.edu/~pmittal">Prateek Mittal</a>.</p>
      <nav aria-label="Links">
        <ul>
          <li>
            <button type="button" class="bracket email" aria-expanded="false" aria-label="Show email address">
              <span class="reveal"><span class="label">Email</span><span class="addr" aria-live="polite"></span></span>
            </button>
          </li>
          {links.map((l) => (
            <li><a class="bracket" href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
</Base>

<script>
  // The address is assembled only on click, so it never appears in the page source.
  const btn = document.querySelector<HTMLButtonElement>('button.email');
  const reveal = btn?.querySelector<HTMLSpanElement>('.reveal');
  const label = btn?.querySelector<HTMLSpanElement>('.label');
  const addr = btn?.querySelector<HTMLSpanElement>('.addr');

  if (btn && reveal && label && addr) {
    // One box whose width slides between the two words, so closing narrows straight back to "Email".
    const fitTo = (el: HTMLElement) => { reveal.style.width = `${el.offsetWidth}px`; };
    fitTo(label);

    btn.addEventListener('click', () => {
      if (!addr.textContent) {
        addr.textContent = 'moc tod liamg ta nwyrrg'.split('').reverse().join('');
      }
      const open = btn.classList.toggle('open');
      fitTo(open ? addr : label);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Hide email address' : 'Show email address');
    });
  }
</script>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(64px, 16vh, 160px) 24px 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-start;
  }

  .photo {
    width: 140px;
    height: 140px;
    border-radius: 4px;
    object-fit: cover;
    flex: none;
    border: 1px solid var(--line);
  }

  .text {
    flex: 1 1 360px;
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-weight: 600;
    font-size: 28px;
    line-height: 1.2;
  }

  p { margin: 16px 0 0; }
  h1 + p { margin-top: 12px; }

  ul {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 16px;
    color: var(--muted);
  }

  /* Bracketed links: [GitHub] instead of underlines. */
  .bracket {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    color: var(--muted);
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 120ms ease;
  }

  .bracket::before { content: '['; }
  .bracket::after { content: ']'; }
  .bracket::before,
  .bracket::after { color: var(--muted); opacity: 0.6; transition: color 120ms ease, opacity 120ms ease; }

  .bracket:hover,
  .bracket:focus-visible { color: var(--accent); }
  .bracket:hover::before,
  .bracket:hover::after,
  .bracket:focus-visible::before,
  .bracket:focus-visible::after { color: var(--accent); opacity: 1; }

  .bracket:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Email: one clipped box slides between the width of "Email" and the address.
     Opening swaps in the address and widens left to right; closing narrows right to left
     to exactly the width of "Email", then swaps the label back. */
  .reveal {
    display: inline-grid;
    grid-template-columns: max-content;
    overflow: hidden;
    vertical-align: bottom;
    transition: width 380ms cubic-bezier(0.3, 0.6, 0.2, 1);
  }

  .reveal > span {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: nowrap;
  }

  .label { transition: opacity 0s 380ms; }
  .addr { opacity: 0; transition: opacity 0s 380ms; }

  .email.open { user-select: text; color: var(--ink); }
  .email.open .label { opacity: 0; transition: none; }
  .email.open .addr { opacity: 1; transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .label, .addr, .bracket, .bracket::before, .bracket::after { transition: none; }
  }
</style>
